      <dmn:contextEntry>
        <dmn:variable id="_05C2DF94-7B35-4FED-AC2A-7AC00FC69174" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_CBEBF58F-7180-479C-8202-E636572182B6" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_39C4B134-1F13-495F-B5A4-9FC2486B473A" typeRef="string">
            <dmn:text>"Age is measured on the screening date, not on a date the program chooses."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_5DF8F1D7-3FBC-4210-844A-2DCCE5643467" typeRef="string">
            <dmn:text>"Whether the spouse lives in the household is taken from the screener answer."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
