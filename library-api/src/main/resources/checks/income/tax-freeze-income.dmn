              <dmn:literalExpression id="_DED6961B-35AE-4575-B8D3-D278BD8A9E8E" typeRef="string">
                <dmn:text>"Apply for the Low-Income Real Estate Tax Freeze (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_76570FE1-A93E-4EF3-81A1-3E702F26C7AA" name="url" typeRef="string"/>
              <dmn:literalExpression id="_E0072EFE-6D56-4138-A9F7-8317FA59443C" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/tax-freeze/apply-for-the-low-income-real-estate-tax-freeze/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_B61BA054-14D4-4B26-ABF8-FD5BF4E39A1F" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_0C78EE47-F392-415A-AE26-83935CDC1A2D" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
          <dmn:context id="_3B65B0A7-01E2-4A27-9C37-83B4A6D114F3" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_A4D2EAB5-000F-467E-9504-2EFBFC797716" name="title" typeRef="string"/>
              <dmn:literalExpression id="_F449F136-F849-4A14-BF5C-7CDA985EB43E" typeRef="string">
                <dmn:text>"Apply for the Low-Income Senior Citizen Real Estate Tax Freeze (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_C057F600-C2F1-4C9D-8FFA-B53D88CF49E9" name="url" typeRef="string"/>
              <dmn:literalExpression id="_95F3FE0A-81BE-41F8-9C7F-5E9A865632A7" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/apply-for-the-low-income-senior-citizen-real-estate-tax-freeze/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_81A8FAD2-0146-46C9-9548-5C9E247214AA" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_021533E4-6EC0-4A34-88AD-0FEF67F00E5A" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_B8DF4415-4807-4560-9DDB-76FED4EBF990" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_E420ADB8-EB59-4E90-9346-DE0994FA3306" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_B9493B8C-D5A8-4095-8697-3CFE0B346B21" typeRef="string">
            <dmn:text>"Combined gross income is taken as given. The City decides which income counts from the documents submitted."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_8A14795B-FEB1-45E9-BD11-56C93CCE9A5A" typeRef="string">
            <dmn:text>"The married limit applies whenever a spouse is listed, wherever the spouse lives."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_CA4A3127-DCF2-4A52-91AB-2C99798D4F9B" typeRef="string">
            <dmn:text>"The limits are those on the City pages when they were checked; the City may change them."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_8A696508-FF4F-4865-9A43-D438E8B9C79A" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_A55330D7-39B5-43E3-9D8D-EBA28772D7A0" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
