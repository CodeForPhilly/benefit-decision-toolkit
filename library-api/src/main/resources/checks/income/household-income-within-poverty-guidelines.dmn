<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_1B513144-C48F-4ACF-96BB-65B3D5B83337" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_F930BB06-CFFE-48AB-B56B-9555274FA2B5" id="_85DE6901-29F2-485C-ABD9-43CD160D68E9" name="HouseholdIncomeWithinPovertyGuidelines" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_1B513144-C48F-4ACF-96BB-65B3D5B83337">
  <dmn:description>Checks that annual household income is at or below a percentage of the HHS poverty guidelines for the household's size.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_9F1A9271-EEBE-4D48-91BB-B31DF4C25EC0" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_AFB6B92A-F9A0-4B53-BCC4-1671FA2E11B4" name="Income" namespace="https://kie.apache.org/dmn/_F930BB06-CFFE-48AB-B56B-9555274FA2B5" locationURI="Income.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:itemDefinition id="_F4496255-961B-4D38-B12E-4507BE3DD563" name="tGuideline" isCollection="false">
    <dmn:itemComponent id="_2AAB4C08-3EAD-4146-A338-51595979266B" name="year" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_E63749E2-FB96-4138-8A85-471B70E5AFD5" name="firstPerson" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_2D04079B-C859-4C15-AA07-9AF7A94666B3" name="eachAdditionalPerson" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_C418F03E-643E-4FA4-AD71-524F63A3CF83" name="tGuidelineList" isCollection="true">
    <dmn:typeRef>tGuideline</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_13B507BC-89BC-4E69-B348-3282673C0422" name="tParameters" isCollection="false">
    <dmn:itemComponent id="_460D304C-32E4-4FEE-997E-FA60B94ABCB5" name="percent" isCollection="false">
      <dmn:description>Percentage of the poverty guideline to use as the income limit, for example 150 for 150%.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_1A5DE427-41AD-4A89-B449-959FD602CEB0" name="guidelineYear" isCollection="false">
      <dmn:description>Year of the HHS poverty guidelines to use, for example 2026.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_D02A4C6E-9209-40CB-A8F1-A281119BE563" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_EA2240CB-1BE3-4E1E-918B-BC56E460F0BB" name="householdIncome" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_46CA9704-EF80-4454-925E-E8A21591FB2F" name="householdSize" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_D6B4B9F4-0FF3-47A7-8D59-20DF03D7FF60" name="HouseholdIncomeWithinPovertyGuidelinesService">
    <dmn:extensionElements/>
    <dmn:variable id="_54C8D086-C772-4A79-AA46-8CA68B2C8098" name="HouseholdIncomeWithinPovertyGuidelinesService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_9A7AD339-E0C3-432D-A42F-D9B6A528107F"/>
    <dmn:inputData href="#_F47CB506-9470-4576-B5E2-C3B8B7A855D5"/>
    <dmn:inputData href="#_4231AB18-3A97-4434-BADE-6629A70A9D3F"/>
  </dmn:decisionService>
  <dmn:decision id="_9A7AD339-E0C3-432D-A42F-D9B6A528107F" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_3F36FE71-7929-4446-AFA9-3C82959AAD51" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_57865EAE-0ABE-42A9-9805-68FC4FF03F41">
      <dmn:requiredInput href="#_F47CB506-9470-4576-B5E2-C3B8B7A855D5"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_0CEF9741-D45C-4F1E-9834-DF6432C6F22A">
      <dmn:requiredInput href="#_4231AB18-3A97-4434-BADE-6629A70A9D3F"/>
    </dmn:informationRequirement>
    <dmn:context id="_D1FB77A8-BCAA-458A-A6B1-2CB947553C1E">
      <dmn:contextEntry>
        <dmn:variable id="_A91D653B-F5AF-48FF-A6F4-E1A08882F6AB" name="guidelines" typeRef="tGuidelineList"/>
        <dmn:literalExpression id="_31C7E6B9-466E-4827-818B-8ADA6365E02D">
          <dmn:text>// HHS poverty guidelines for the 48 contiguous states and DC
[
  {year: 2026, firstPerson: 15960, eachAdditionalPerson: 5680}
]</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_DF691E78-982F-47FE-9CF2-AC7717E5396D" name="guideline" typeRef="tGuideline"/>
        <dmn:literalExpression id="_57F535C3-3B62-48B0-B4ED-CE5673B023AC">
          <dmn:text>guidelines[item.year = parameters.guidelineYear][1]</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_F6BDD763-382F-4B07-BCAB-226963548498" name="income" typeRef="number"/>
        <dmn:literalExpression id="_8E845DCD-8B1C-4464-A3C8-6080A0D7C964">
          <dmn:text>situation.householdIncome</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_AC8D9683-DCA3-48CC-B616-618645CEFAE4" name="size" typeRef="number"/>
        <dmn:literalExpression id="_30789DCC-242A-4080-BCE9-3C5A48F91EDA">
          <dmn:text>situation.householdSize</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_50551049-F1BE-4D38-9C0D-D004BA1D4F80" name="limit" typeRef="number"/>
        <dmn:literalExpression id="_2CA8EDD6-EF72-4679-BD71-D1CC6E9B99A2">
          <dmn:text>if guideline = null or size = null or parameters.percent = null then null
else (guideline.firstPerson + (size - 1) * guideline.eachAdditionalPerson) * parameters.percent / 100</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_04692AB6-FBDD-48B2-B8B7-EEA7319569C0">
          <dmn:text>if income = null or income &lt; 0 or size = null or size &lt; 1 or floor(size) != size then null
else if parameters.percent = null or parameters.percent &lt; 0 or limit = null then null
else income &lt;= limit</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:decision id="_B4F27BF9-BB4D-4260-961A-73A321E12DEC" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_41829559-DBB0-4511-87CA-68F244AD748E" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:literalExpression id="_842DD49E-A143-4E82-B35D-1824935873F9">
      <dmn:text>{
  explanation: "Finds the HHS poverty guideline for the household's size, multiplies it by the given percent, and passes when annual household income is equal to or less than the result. For 2026 the guideline is $15,960 for one person plus $5,680 for each additional person, so 150% is $23,940 for one person plus $8,520 for each additional person. Returns no result when income or household size is missing or invalid, or when the guideline year is not available.",
  sources: [
    {
      title: "Pennsylvania LIHEAP FFY 2027 Final State Plan",
      url: "https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf",
      citation: "Income eligibility: 150% of the 2026 federal poverty guidelines, by household size",
      checkedOn: date("2026-11-12")
    },
    {
      title: "Pennsylvania DHS: LIHEAP",
      url: "https://www.pa.gov/agencies/dhs/resources/liheap",
      citation: "Income limits by household size",
      checkedOn: date("2026-11-12")
    }
  ],
  limitations: [
    "Only the 2026 guidelines are available. Any other guideline year returns no result.",
    "Uses the guidelines for the 48 contiguous states and DC, not those for Alaska or Hawaii.",
    "Takes household income and size as given. It does not decide whose income counts, which income is excluded, or how pay is annualized.",
    "Does not round the limit. A program that publishes rounded limits may differ by a few dollars."
  ],
  lastReviewed: date("2026-11-12")
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_F47CB506-9470-4576-B5E2-C3B8B7A855D5" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_A5A3D95B-160A-4F72-B1DB-EB47323C15B8" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:inputData id="_4231AB18-3A97-4434-BADE-6629A70A9D3F" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_8A27169E-A3A5-47C2-B4C7-1EA9926B0003" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>
  <dmn:textAnnotation id="_CD771E7D-2BC8-4F13-81AE-FFAB800A26F1" textFormat="text/plain">
    <dmn:text>The 2026 values were derived from PA LIHEAP's published 150% table ($23,940 for one person, plus $8,520 for each additional person). Add each new year to the guidelines list when HHS publishes it in January.</dmn:text>
  </dmn:textAnnotation>
