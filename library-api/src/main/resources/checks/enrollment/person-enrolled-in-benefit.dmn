<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_CB10DDEF-33B4-43C5-AD7D-55A06060FF2A" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:included1="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465" xmlns:included2="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_4836FB2E-EA9A-46D1-B532-C5FD8DCFEDE6" name="PersonEnrolledInBenefit" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_CB10DDEF-33B4-43C5-AD7D-55A06060FF2A">
  <dmn:description>Verify that a specified person is enrolled in a specified benefit program.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_222D61DF-1815-4010-AE37-6877961473E5" name="Enrollment" namespace="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465" locationURI="Enrollment.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_FFA4D8BE-A021-4476-8526-7D8E448C5203" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:itemDefinition id="_8567E466-E20E-4F59-9334-E330CBCA5D6C" name="tParameters" isCollection="false">
    <dmn:itemComponent id="_B3CDA42A-A38B-49B5-9739-ACC6D59C3A67" name="personId" isCollection="false">
      <dmn:description>Id of the person to look for in situation.enrollments.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_4C0F9068-CC20-4E20-BAFF-7C3689428892" name="benefit" isCollection="false">
      <dmn:description>Name of the benefit as recorded in situation.enrollments, for example PhlHomesteadExemption.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_5FEC4CA8-D726-4C55-97F3-8F9FA9922265" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_94619560-6343-44FE-B511-EADD8472F7D4" name="enrollments" isCollection="false">
      <dmn:typeRef>Enrollment.tEnrollmentList</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_5E85B343-11FA-4C1C-A08E-26402F99720E" name="PersonEnrolledInBenefitService">
    <dmn:extensionElements/>
    <dmn:variable id="_3E45EB79-1A6E-4E4B-B052-7A8205F58B69" name="PersonEnrolledInBenefitService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_11496BDA-61EA-44BB-AB63-A5A272ED2472"/>
    <dmn:inputData href="#_222EBF53-16BF-4A13-A424-0AD32C90100D"/>
    <dmn:inputData href="#_7E377FA3-246D-4CBF-AE45-3A3AFDB7372B"/>
  </dmn:decisionService>
  <dmn:decision id="_11496BDA-61EA-44BB-AB63-A5A272ED2472" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_B50CA751-1E2E-4C2E-9C73-03285F3DD428" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_669BFE51-E50C-444C-853C-D6F45C4869F3">
      <dmn:requiredInput href="#_7E377FA3-246D-4CBF-AE45-3A3AFDB7372B"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_9164FE76-0C6C-4D96-9CBD-5EC2639D22A8">
      <dmn:requiredInput href="#_222EBF53-16BF-4A13-A424-0AD32C90100D"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_EC3D9380-90FD-4FE1-9640-F713DE0BD846">
      <dmn:text>if situation.enrollments != null and parameters.personId != null and parameters.benefit != null then
  some enrollment in situation.enrollments satisfies enrollment.personId = parameters.personId and enrollment.benefit = parameters.benefit
else
  null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_7E377FA3-246D-4CBF-AE45-3A3AFDB7372B" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_2419935F-CC59-4166-8E2B-1EAA14C4760E" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:inputData id="_222EBF53-16BF-4A13-A424-0AD32C90100D" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_9DFB57D8-83D9-4AB9-B59D-D3EEAA143902" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>
  <dmn:decision id="_8ADE437C-95B1-43CE-8ECC-2191340E0E74" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_5F748F53-47E2-4220-8DC2-3F59DB70D99E" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_4764C4D8-E06E-4A45-A4B3-A41DFD51F9AF" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_0974D147-87EE-41B2-901E-283886E96738" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_561F5A2A-4956-462D-B65D-1683200F69F7" typeRef="string">
          <dmn:text>"Passes when situation.enrollments lists the person as enrolled in the named benefit, and fails when it does not. Returns no result when the enrollments list is missing, or when the personId or benefit parameter is missing."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_87E343DC-D7CF-4C4F-B639-08F01A6915AC" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_5C01372F-E3EA-4CD3-A934-335BE0D9DB0C" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_F51F59EC-EC27-454C-8A63-3868ED211FD9" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_73539B71-E879-4728-80EB-AB0C4337AD5C" name="title" typeRef="string"/>
              <dmn:literalExpression id="_EC4598F6-8B11-43AF-B350-644B6A44D721" typeRef="string">
                <dmn:text>"Benefit Decision Toolkit situation data model (BDT.dmn)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_3A5AABF1-2120-49D3-84A0-4C4BC186798B" name="url" typeRef="string"/>
              <dmn:literalExpression id="_497442AA-355C-439E-BAE1-5D0BB1271ABB" typeRef="string">
                <dmn:text>"https://github.com/CodeForPhilly/benefit-decision-toolkit/blob/main/library-api/src/main/resources/BDT.dmn"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_E3039BAD-71A8-4E63-A595-EE03AB39F23B" name="citation" typeRef="string"/>
              <dmn:literalExpression id="_F45B7B4B-AE7D-4FCE-A681-5E2B02086D4B" typeRef="string">
                <dmn:text>"tSituation: enrollments[].personId, enrollments[].benefit"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_47AFB725-EBA2-4848-BD4B-C685414F919A" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_42DBEB4E-2126-4FF4-87C0-DA3885467815" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_9F2097F2-CA36-4FA1-B84B-D1F051253E90" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_97815CA7-FBEF-48E1-8969-A31CC352BF4E" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_D37CBE40-8F7A-4672-A847-ACB9FBCE601B" typeRef="string">
            <dmn:text>"Relies on the enrollments the screener reports. It does not look up enrollment with the agency."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_B78DFDF5-7B05-41E0-A328-F59652CAE6AC" typeRef="string">
            <dmn:text>"Benefit names must match exactly."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_93FF6410-4BE8-4CD3-A4C0-C04898F6FAC9" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_58ACC168-E454-4F88-BFCA-C071E81A1063" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
