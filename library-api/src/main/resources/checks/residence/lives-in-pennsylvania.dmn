      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_D40DD0B1-EFAF-491F-A3CD-E4BA579C5F93" name="LivesInPennsylvaniaService">
    <dmn:extensionElements/>
    <dmn:variable id="_8208C53D-241A-4A1C-A6A8-605F7E2603DD" name="LivesInPennsylvaniaService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_D67E2075-1814-40FD-8DC2-111A33C9D0B4"/>
    <dmn:inputData href="#_B4D397D5-1AA1-474B-BAAA-547C3B5A6224"/>
  </dmn:decisionService>
  <dmn:decision id="_D67E2075-1814-40FD-8DC2-111A33C9D0B4" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_EF7E884B-A610-47C1-8109-7914C389CBB5" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_CB3D6497-61D8-422D-8B9B-D28667B85551">
      <dmn:requiredInput href="#_B4D397D5-1AA1-474B-BAAA-547C3B5A6224"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_D8016795-E53D-4E18-8079-E26592CA0FFE">
      <dmn:text>if situation.simpleChecks != null and situation.simpleChecks.livesInPennsylvania != null then
  situation.simpleChecks.livesInPennsylvania = true
else
  null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:decision id="_394A880D-ADF1-4CBF-8BB3-A5B4157B499C" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_37BD6D21-64AC-4206-8B98-41B1CEF2FFC4" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:literalExpression id="_74ADBED6-BBAE-422D-A224-AA1731CD9BD9">
      <dmn:text>{
  explanation: "Passes when the screener answer says the household lives in Pennsylvania, and fails when it says the household does not. Returns no result when the answer is missing.",
  sources: [
    {
      title: "Pennsylvania LIHEAP FFY 2027 Final State Plan",
      url: "https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf",
      citation: "Appendix B, 601.31(3): residency",
      checkedOn: date("2026-11-12")
    }
  ],
  limitations: [
    "Relies on the screener answer. It does not look up or verify an address.",
    "Does not tell a permanent home in Pennsylvania apart from a temporary stay."
  ],
  lastReviewed: date("2026-11-12")
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
