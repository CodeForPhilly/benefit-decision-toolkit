    <dmn:itemComponent id="_CBE0A46D-433A-47EF-AE62-68DC3A8E92B5" name="livesInPennsylvania" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
