  <dmn:itemDefinition id="_FD163B09-264D-4DC4-91C7-867FE97ED5FF" name="tSimpleChecks" isCollection="false">
    <dmn:itemComponent id="_CD8DFE2D-C826-4DC7-82F6-8B29B4417856" name="livesInPennsylvania" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_AFD4E3F2-0E61-4568-8328-8D0440E1236C" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_2538064C-F981-403C-964E-67867BC94BF3" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_E7FE937B-6F8F-4CB3-BAD0-378F704616D5" name="LivesInPennsylvaniaService">
    <dmn:extensionElements/>
    <dmn:variable id="_DBB33086-E5C0-4505-9D00-23AFDDEF6A05" name="LivesInPennsylvaniaService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_8EFC3D22-CD03-4700-8F38-B6DA134CD174"/>
    <dmn:inputData href="#_A49317A2-80CE-4ED9-BC2B-F537FF7E585C"/>
  </dmn:decisionService>
  <dmn:decision id="_8EFC3D22-CD03-4700-8F38-B6DA134CD174" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_B041AFC8-385D-43A5-97B3-0F6A779C4305" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_9178BE59-1C8C-4C0F-8234-0452C2577A5B">
      <dmn:requiredInput href="#_A49317A2-80CE-4ED9-BC2B-F537FF7E585C"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_CEC648A9-871D-4F0A-977D-81F67471EE22">
      <dmn:text>if situation.simpleChecks != null and situation.simpleChecks.livesInPennsylvania != null then
  situation.simpleChecks.livesInPennsylvania = true
else
  null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:decision id="_AC035827-A226-4485-ADCC-F43D16095F70" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_012E6863-8420-4097-B31B-728B424B4212" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:literalExpression id="_3996FA0C-1BE1-4855-BDE6-6D0797477A40">
      <dmn:text>{
  explanation: "Passes when the screener answer says the household lives in Pennsylvania, and fails when it says the household does not. Returns no result when the answer is missing.",
  sources: [
    {
      title: "Pennsylvania LIHEAP FFY 2027 Final State Plan",
      url: "https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf",
      citation: "Appendix B, 601.31(3): residency",
      checkedOn: date("2026-11-12")
    }
  ],
  limitations: [
    "Relies on the screener answer. It does not look up or verify an address.",
    "Does not tell a permanent home in Pennsylvania apart from a temporary stay."
  ],
  lastReviewed: date("2026-11-12")
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
