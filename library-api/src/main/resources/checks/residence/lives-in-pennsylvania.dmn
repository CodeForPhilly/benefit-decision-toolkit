  <dmn:itemDefinition id="_F5F0EC9E-A199-4FE7-8AA9-7F264C4C4229" name="tSimpleChecks" isCollection="false">
    <dmn:itemComponent id="_CBE0A46D-433A-47EF-AE62-68DC3A8E92B5" name="livesInPennsylvania" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_DD8213E5-0C66-4F83-8771-F1A6958B153D" name="tSituation" isCollection="false">
