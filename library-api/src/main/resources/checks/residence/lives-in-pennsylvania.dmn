  <dmn:description>Checks that the household lives in Pennsylvania.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_892B17EF-5DC9-48C4-9DD2-3C3ADA5D6919" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
