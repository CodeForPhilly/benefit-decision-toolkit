  <dmn:description>Checks that the household lives in Pennsylvania.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_D057431C-C045-4613-AF40-172B42BE869F" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
