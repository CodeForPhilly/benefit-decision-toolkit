          <dmn:context id="_40386EB1-BCD5-4B7A-92DF-C228FE1754F1" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_2668728F-FA82-4510-AE30-901E06979BFD" name="title" typeRef="string"/>
              <dmn:literalExpression id="_2E8A7F53-0826-4BE8-BECE-5EBA0C22C31D" typeRef="string">
                <dmn:text>"Get the Homestead Exemption (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_499AE495-1809-477C-8A5A-9DCEB33D1D26" name="url" typeRef="string"/>
              <dmn:literalExpression id="_A3F970F6-2BC4-49CB-A69E-E793C69AFB17" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/get-the-homestead-exemption/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_5786C133-5077-4A8F-8E06-9C6805B19CEF" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_2DF21380-E934-4CFA-8D06-37FDDA80E7B9" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_B9C3F224-E501-45EC-BFAF-B8ECB775DA73" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_12D27CD3-A068-4B4A-9844-04CB6997A0E3" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_C7E236C2-4BA5-4811-8840-DCC5F5CCF5C6" typeRef="string">
            <dmn:text>"Relies on the screener answer. It does not look up or verify an address."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_EBDCB4F5-E921-41D9-ADCF-75CDA27B845D" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_03699E80-9725-44BE-8FD3-83BBFDD6042D" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
