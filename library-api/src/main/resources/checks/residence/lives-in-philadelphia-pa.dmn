  <dmn:decision id="_7DF79A7F-C8AD-4107-B6C2-55D4A5BC0325" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_079F97A9-7DC0-45CA-88AB-F1AB933F8595" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_6AC09CD9-7593-45CF-B6CF-EC73F967912C" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_D36178C1-3DCC-4C34-B61D-81D028E1B249" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_04B3677A-696C-4B74-9C4D-FB5D925DE471" typeRef="string">
          <dmn:text>"Passes when the screener answer says the person lives in Philadelphia, Pennsylvania, and fails when it says they do not. Returns no result when the answer is missing."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_D69EFF56-076E-4DE0-A34B-7D440305FDAB" name="sources" typeRef="BDT.tReferenceSourceList"/>
