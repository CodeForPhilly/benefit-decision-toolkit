      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_B8D3F1C5-2A6E-4C7F-E5A1-9D4B2F8C6E3A" name="Residence"
      namespace="https://kie.apache.org/dmn/_C9F91EE8-9F17-4867-9638-912AC7DB68F1"
      locationURI="Residence.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_7C5A3D9E-4F1B-4A8D-F7C5-2E6A4D8F1C9B" name="TenYearTaxAbatement"
      namespace="https://kie.apache.org/dmn/_3A7F1C2D-8E4B-4A91-B5C3-2D6F8A1E4C79"
      locationURI="ten-year-tax-abatement.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:itemDefinition id="_3F1B7E9D-8C4A-4E6B-A3D7-5B9F2C1D8E4A" name="tSimpleChecks" isCollection="false">
    <dmn:itemComponent id="_9A5D2F1C-7B3E-4F4D-CBBC-1E7D3B5F9A2C" name="tenYearTaxAbatement" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_5D8C4A7F-1B9E-4A9C-DCCD-3C5A1F7B4D8E" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_2B6F1E9C-4D7A-4B3E-EDDE-7F2A4C8B1D5F" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_E4A7C1D9-3F5B-4D1F-FEEF-4B8E2D6A9C3F" name="NoTenYearTaxAbatementService">
    <dmn:extensionElements/>
    <dmn:variable id="_8F3B5E2A-7D1C-4E4A-A9F7-6D3A8F2B5C1E" name="NoTenYearTaxAbatementService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_1D5F9C3B-2A7E-4F6A-BAAB-9E4D1B7F3C5A"/>
    <dmn:inputData href="#_3F8E1D5B-7A4C-4D5B-A9B7-1E6C8D3F9A5B"/>
  </dmn:decisionService>
  <dmn:decision id="_1D5F9C3B-2A7E-4F6A-BAAB-9E4D1B7F3C5A" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_6C2A8E4D-5F1B-4A2B-CBBC-3B7F9E2D6A4C" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_4A7D3F1C-9B5E-4B4C-DCCD-8C1D4A7F2B9E">
      <dmn:requiredInput href="#_3F8E1D5B-7A4C-4D5B-A9B7-1E6C8D3F9A5B"/>
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_B5E1C8A3-6D2F-4C3D-EDDE-2A9F5C3E1B7D">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_3A7F1C2D-8E4B-4A91-B5C3-2D6F8A1E4C79#_3C6E1A4B-4B5D-4CAD-F8E6-2F7D5C9E4A3E"/>
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_9D4B6F2E-1C8A-4C3E-FEEF-5F1B9D3C7E4A">
      <dmn:text>not(TenYearTaxAbatement.TenYearTaxAbatementService(situation: situation))</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_3F8E1D5B-7A4C-4D5B-A9B7-1E6C8D3F9A5B" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_7B3C9F2E-4A1D-4C6F-B3C8-5D9A2F7B1E4C" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:decision id="_2A1FF2E0-233C-4B03-91CE-E0D32DF12DF7" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_4F1E3FBA-E3FD-4477-BC70-33A8AD02809A" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_E8D0113E-2C68-4780-9026-151EE7712F6A" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_23240937-F888-476F-81FB-7AAC05DF895C" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_70F952AD-4C5F-45C2-9246-CA6C4AEF11B4" typeRef="string">
          <dmn:text>"The opposite of TenYearTaxAbatement: passes when the screener answer says the property does not have an active 10-year residential tax abatement, and fails when it does. Returns no result when the answer is missing."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_EA50B7AC-2ED6-46A4-B3D6-EBB100B32435" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_9FD1328D-8828-4E61-A07A-9A7635180D36" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_D607BD06-F650-49BC-ADB9-E755CB1474C2" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_12BAD5F9-2447-4F40-992C-B7FBE3D9E76B" name="title" typeRef="string"/>
              <dmn:literalExpression id="_F5B055D9-2504-4390-830B-F0F42C2ECAD1" typeRef="string">
                <dmn:text>"Get the Homestead Exemption (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_5B8FD5FF-379D-497F-88FD-2167EE7D57AF" name="url" typeRef="string"/>
              <dmn:literalExpression id="_0A3E94DD-89DC-419A-9F5D-349C399B72C9" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/get-the-homestead-exemption/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_38E34083-41CC-4BDB-B441-E9E3BE8E3483" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_70F0A89D-F397-4716-93A6-594C3F58AE63" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_B1854A6B-4CCA-4C8F-8752-479B71DE2CD1" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_BD7DEA59-0893-4499-A63A-F200752684B7" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_E7D323B1-FB13-4CD1-A659-58560C9EDEB0" typeRef="string">
            <dmn:text>"Relies on the screener answer. It does not look up or verify records."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_8D64C4CA-6B70-4660-AA34-DB248E8BBE80" typeRef="string">
            <dmn:text>"Only active abatements count. Past abatements that have ended do not."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_BAC44BEA-77CD-4D6F-B4C4-558AB63EAE49" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_D9E4EB71-02AB-48A8-8B62-3DA73141E6FA" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
