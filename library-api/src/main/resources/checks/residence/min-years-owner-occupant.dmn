          <dmn:context id="_76D7B669-645B-4D85-91F3-852B328CF124" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_83660683-7DF1-4DAB-8562-C273A41EE896" name="title" typeRef="string"/>
              <dmn:literalExpression id="_41662473-7D63-449D-9AB3-9F409C4BF94B" typeRef="string">
                <dmn:text>"Apply for the Longtime Owner Occupants Program (LOOP) (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_BF7F530B-598D-431E-BA2F-CE3BADB9AFE5" name="url" typeRef="string"/>
              <dmn:literalExpression id="_BCC975A5-1092-4E25-ABB9-A11985326759" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/apply-for-the-longtime-owner-occupants-program-loop/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_DF2B0058-3BE3-4CD7-9ACC-8994FBD7B7FE" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_DBB4A924-F47A-4174-AF90-4464C6A0ED2E" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_EA556A14-3432-448D-993D-EED2E1A5A586" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_9E17EF5C-A29F-43CB-8F06-F7DA17C4F6D2" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_8C561458-327C-4B7F-92C3-7BBE100C8D01" typeRef="string">
            <dmn:text>"The number of years is taken from the screener answer, not from deed records."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_E2DEEFE7-4869-4061-873A-000496779170" typeRef="string">
            <dmn:text>"Does not check whether time in the home was continuous."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_4472E41B-0661-4FAC-BD83-1530B365A2C4" name="lastReviewed" typeRef="date"/>
