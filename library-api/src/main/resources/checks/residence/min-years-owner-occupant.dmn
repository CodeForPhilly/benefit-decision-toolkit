    <dmn:variable id="_3AB3D7C0-3813-4D74-960F-A1E7E89D1FCE" name="parameters" typeRef="tParameters" />
  </dmn:inputData>
  <dmn:decision id="_B4942FE6-A7FF-475E-B3B9-7BE72DA3865D" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_731B6F33-9D90-4066-8E13-D67A303E384D" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_C54F546E-4BC4-48F6-8974-D75FB96CADA5" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_8316417E-7823-46FF-BA7E-8AC934789D1D" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_6CBC950F-42AE-4CDE-AC83-36122FD0F792" typeRef="string">
          <dmn:text>"Passes when the applicant has owned and lived in their primary residence for at least the minimum number of years. Returns no result when the number of years or the minYears parameter is missing or negative."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_6240D534-BFEA-4810-8FC8-22EECA6C66FA" name="sources" typeRef="BDT.tReferenceSourceList"/>
