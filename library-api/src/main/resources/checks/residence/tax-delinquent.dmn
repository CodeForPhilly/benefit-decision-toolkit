    id="_5FA6D636-B06D-466E-A580-73F9D11999D7"
    name="TaxDelinquent"
    typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/"
    namespace="https://kie.apache.org/dmn/_F26CE0F4-1FF7-404A-9EF3-788224C69FE5">
  <dmn:description>Checks whether the property owner has delinquent taxes.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_5CC41E8A-DDE8-4102-8E2E-D1E988CA4EB5" name="BDT"
      namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79"
      locationURI="../BDT.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_F834A1B5-5186-4122-8DB1-0A21699EE86B" name="Residence"
      namespace="https://kie.apache.org/dmn/_C9F91EE8-9F17-4867-9638-912AC7DB68F1"
      locationURI="Residence.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:itemDefinition id="_49FCA0D5-0B51-4390-9CB6-6DC5E35A4761" name="tSimpleChecks" isCollection="false">
    <dmn:itemComponent id="_7A1A8CC7-2108-490A-95A1-1AA19C7E937D" name="taxDelinquent" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_9427B5B5-0BE5-4617-9D6B-07D59240433B" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_1A2CC650-C64F-40AC-82DC-50994805CE53" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_C41C2468-7290-4E8E-895F-8D0F648C6E26" name="TaxDelinquentService">
    <dmn:extensionElements/>
    <dmn:variable id="_5B39FF18-4AA5-42FD-8928-B6FAB73FD206" name="TaxDelinquentService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_76277271-E005-4934-8D0F-5C4433255927"/>
    <dmn:inputData href="#_828BBBD1-BA7A-488F-A5A6-C00779022AFA"/>
  </dmn:decisionService>
  <dmn:decision id="_76277271-E005-4934-8D0F-5C4433255927" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_2F37315B-D351-4659-AE85-285F44535669" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_07BEBD90-1E94-4896-BD69-9777D3F2A582">
      <dmn:requiredInput href="#_828BBBD1-BA7A-488F-A5A6-C00779022AFA"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_28B95B89-9C86-4487-86E1-D33FA6BD82DA">
      <dmn:text>if situation.simpleChecks != null and situation.simpleChecks.taxDelinquent != null then
  situation.simpleChecks.taxDelinquent = true
else
  null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_828BBBD1-BA7A-488F-A5A6-C00779022AFA" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_0C7450FD-92FB-4B23-AE1E-8561C0E0CD4F" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:decision id="_5F79127A-4CEE-4107-951F-392B99859422" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_88A1EE93-3980-443C-B220-B5CA7007EAE0" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_F91D91C7-B911-489C-8B07-151B070491C5" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_7CEF0252-90BB-4957-A738-86984D142DA1" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_C3A990F2-2374-4BC5-ADE4-358C71D0CA08" typeRef="string">
          <dmn:text>"Passes when the screener answer says the property owner has past-due Real Estate Tax, and fails when it says they do not. Programs for owners who are behind on taxes use it directly; others use it through PropertyTaxesCurrentOrPaymentPlan. Returns no result when the answer is missing."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_24A5948B-5228-4F08-A5C9-C9F1AFDA2186" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_D748A351-9792-4009-941A-F88BA2C9536E" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_725F05F5-37D5-4EB8-8794-5E7215B0D8ED" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_DF11B55A-79CE-458B-81E4-8A3EF4F5DF27" name="title" typeRef="string"/>
              <dmn:literalExpression id="_3D06E47C-25D4-4516-82D2-F6693A9ECA86" typeRef="string">
                <dmn:text>"Set up an Owner-Occupied Real Estate Tax Payment Agreement (OOPA) (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_5BEAA9DC-AD3B-44A5-AE88-F3114FA7C3B0" name="url" typeRef="string"/>
              <dmn:literalExpression id="_1F4EF794-9BC8-476D-A470-CF09B4F3725C" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/set-up-an-owner-occupied-real-estate-tax-payment-agreement-oopa/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_8627617F-A9B3-4152-AD94-5F56B0FB7BB6" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_2A0F4EC3-C956-4247-AD1C-4C160735F912" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_41ECD6AE-32E5-4760-8427-6E638608105F" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_95491BBB-D414-435E-A588-FE3E045C809F" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_4D2124C2-B664-4310-901B-90FDB61BADC2" typeRef="string">
            <dmn:text>"Relies on the screener answer. It does not look up or verify records."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_732AAA86-CF85-44DE-BC2C-AE4FB53749D0" typeRef="string">
            <dmn:text>"Does not check how much is owed or for how long."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_BA0B5610-895E-4ECF-8076-6A4E164EB30B" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_5120AF72-CBF8-4E11-8986-148FF424CA77" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
