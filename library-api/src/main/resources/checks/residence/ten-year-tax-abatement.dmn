<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions
    xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/"
    xmlns="https://kie.apache.org/dmn/_3A7F1C2D-8E4B-4A91-B5C3-2D6F8A1E4C79"
    xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/"
    xmlns:kie="https://kie.org/dmn/extensions/1.0"
    xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
    xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
    xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
    xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79"
    xmlns:included2="https://kie.apache.org/dmn/_C9F91EE8-9F17-4867-9638-912AC7DB68F1"
    id="_1B4C8E3F-7A2D-4B6E-9A1C-5E2D7F3A9B8C"
    name="TenYearTaxAbatement"
    typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/"
    namespace="https://kie.apache.org/dmn/_3A7F1C2D-8E4B-4A91-B5C3-2D6F8A1E4C79">
  <dmn:description>Checks that a property has an active 10-year tax abatement.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_7C2D5F1A-3B8E-4C4D-8B2E-1F5A9C3D7E4B" name="BDT"
      namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79"
      locationURI="../BDT.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:import id="_4D8F3A2B-9C1E-4D5E-A3F1-6A2E8D4B1C7F" name="Residence"
      namespace="https://kie.apache.org/dmn/_C9F91EE8-9F17-4867-9638-912AC7DB68F1"
      locationURI="Residence.dmn"
      importType="https://www.omg.org/spec/DMN/20240513/MODEL/"/>
  <dmn:itemDefinition id="_9E1A4C7F-2D3B-4E6F-B4A2-7B3F1E9C2D8A" name="tSimpleChecks" isCollection="false">
    <dmn:itemComponent id="_2F5B8D3A-7E4C-4F7A-C5B3-8C4A2F6E1D9B" name="tenYearTaxAbatement" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_5A2C6E1D-8F3B-4A8B-D6C4-9D5B3A7F2E1C" name="tSituation" isCollection="false">
    <dmn:itemComponent id="_8B3D7F2E-1A4C-4B9C-E7D5-1E6C4B8A3F2D" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_3C6E1A4B-4B5D-4CAD-F8E6-2F7D5C9E4A3E" name="TenYearTaxAbatementService">
    <dmn:extensionElements/>
    <dmn:variable id="_6D9F4B7C-7C6E-4DBE-A9F7-3A8E6D1B5C4F" name="TenYearTaxAbatementService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_1E2A5C8D-9D7F-4ECF-BAAB-4B9F7E2C6D5A"/>
    <dmn:inputData href="#_BE6EA3B4-4BD4-4C4A-FEEF-8FD4DB6AAB9E"/>
  </dmn:decisionService>
  <dmn:decision id="_1E2A5C8D-9D7F-4ECF-BAAB-4B9F7E2C6D5A" name="checkResult">
    <dmn:extensionElements/>
    <dmn:variable id="_4F3B6D9E-1EA1-4FD1-CBBC-5CA1AF3D7E6B" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_7A4C8E1F-2FB2-4A2E-DCCD-6DB2BF4E8F7C">
      <dmn:requiredInput href="#_BE6EA3B4-4BD4-4C4A-FEEF-8FD4DB6AAB9E"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_AF5D9F2A-3AC3-4B3F-EDDE-7EC3CA5F9A8D">
      <dmn:text>if situation.simpleChecks != null and situation.simpleChecks.tenYearTaxAbatement != null then
  situation.simpleChecks.tenYearTaxAbatement = true
else
  null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_BE6EA3B4-4BD4-4C4A-FEEF-8FD4DB6AAB9E" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_CF7FB4C5-5CE5-4D5B-AF1A-9AE5EC7BBC1F" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:decision id="_318B663A-C5D9-4B0D-B0A2-F34BD2AFA123" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_BE4601BD-B99A-497C-8B1D-F93B781F6B68" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_51818827-3577-403D-8C56-463F8B8B6AF6" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_032CF19E-0A67-4510-866B-AE7A7AF20674" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_4FB8E826-0B67-4FEE-8BAB-B5DD249CF630" typeRef="string">
          <dmn:text>"Passes when the screener answer says the property has an active 10-year residential tax abatement, and fails when it says it does not. Returns no result when the answer is missing."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_98CE58B9-469D-4DEF-AEDC-0B3E4959DC92" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_B1270681-FFE0-477C-8431-5F712F18DE73" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_7A866ADA-EF5F-4D27-9190-8CA95645E372" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_754E3B52-8232-4CB1-AB83-1F5632855733" name="title" typeRef="string"/>
              <dmn:literalExpression id="_E4E49E67-875D-472F-8CB3-5B148530CE30" typeRef="string">
                <dmn:text>"Get the Homestead Exemption (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_6F38DB9A-A186-492D-9BE4-93BD56297A26" name="url" typeRef="string"/>
              <dmn:literalExpression id="_8C07AEBF-6968-4E14-A742-D00F79F4D2DF" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/get-the-homestead-exemption/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_6EB7E3A3-8724-4B83-897F-E7DD3F872881" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_1A43619A-44F6-4690-8C93-C64DA82E1F75" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_D07A7597-18D1-4541-B2E1-55496EB7C3ED" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_11853848-092D-4082-9218-BA548167905C" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_6DB12D1A-A37D-4DA2-8530-54BDA1C9BE32" typeRef="string">
            <dmn:text>"Relies on the screener answer. It does not look up or verify records."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_389FC58E-1051-49B8-9BF4-A12E70B87D1A" typeRef="string">
            <dmn:text>"Only active abatements count. Past abatements that have ended do not."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_E075969F-7910-4837-951B-7BA749C71B20" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_8804F02A-C03E-47A1-A45C-A9B6793B33E0" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_D181C5D6-6DF6-4E6C-BA2B-ABF6FD8CCD2A" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_AF5D9F2A-3AC3-4B3F-EDDE-7EC3CA5F9A8D">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
