  <dmn:decision id="_5E645CFC-6ACD-4E9F-B60E-2336035CDC27" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_307E949D-C68C-4DDA-B2FF-0238C0557EB2" name="reference" typeRef="BDT.tEligibilityCheckReference"/>
    <dmn:context id="_9BE70A52-05E7-4FED-996E-D6399211CB38" typeRef="BDT.tEligibilityCheckReference">
      <dmn:contextEntry>
        <dmn:variable id="_D941D73B-69E5-461A-BB13-B765C060F485" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_31413295-41FC-4195-9966-7D1CA06EBB4F" typeRef="string">
          <dmn:text>"Passes when ApplicantOrSpouseMinAge passes with a minimum age of 65, or when RetipIncome passes. Seniors qualify whatever their income. Fails only when both paths fail, and returns no result when neither path passes and one of them has no result."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_DD3FCC7E-AED5-435D-82A7-41F7F7A3D9D2" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_96AA6E5D-F2F4-48DE-8455-F317EC1E4C3F" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_89344F1A-946D-456B-84C1-6EA98EEFD5EF" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_6DA1B3A5-348B-4D85-AC9E-81D44349D6EA" name="title" typeRef="string"/>
              <dmn:literalExpression id="_6B7A3387-318B-4A93-BECC-384299342D4D" typeRef="string">
                <dmn:text>"Set up a Real Estate Tax Installment Plan (City of Philadelphia)"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_883FE8D9-F365-427C-9FB5-7482AEC20A62" name="url" typeRef="string"/>
              <dmn:literalExpression id="_5AD53EA7-B425-4A11-AA94-511BB9092238" typeRef="string">
                <dmn:text>"https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/set-up-real-estate-tax-installment-plan/"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_7A47C7F5-D29E-4824-A2A5-143EB027285E" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_94B90666-A4C2-4C9C-9035-C3F560BB7C51" typeRef="date">
                <dmn:text>date("2026-11-19")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_BE436487-5659-46A1-AE3D-758629AC8BE4" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_31A08A22-6689-4AEE-8BEE-073A07080703" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_4596A42F-DF51-4323-AAEE-90E10B4FC35E" typeRef="string">
            <dmn:text>"Age is measured on the screening date."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_F848AC9B-4AD6-43B2-ACF7-FBE6441BD6CC" typeRef="string">
            <dmn:text>"Unlike the Senior Citizen Tax Freeze, there is no path for a widow or widower of someone who reached 65."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_582AC3EA-1B0C-4065-B418-9FAEF6D2B5FC" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_F268D020-3471-450A-B8E1-9FE8F6B0B0BA" typeRef="date">
          <dmn:text>date("2026-11-19")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
