                </dmn:literalExpression>
              </dmn:contextEntry>
              <dmn:contextEntry>
                <dmn:variable id="_CD237D74-1FBA-4B90-BB88-C037F33DF22E" name="guidelineYear" typeRef="number"/>
                <dmn:literalExpression id="_9DFB1E4A-37C5-4350-9129-9812BEF3A39E">
                  <dmn:text>2026</dmn:text>
                </dmn:literalExpression>
              </dmn:contextEntry>
            </dmn:context>
          </dmn:binding>
        </dmn:invocation>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_B0635B7A-E6B8-4ACC-A379-5D836BFE91A2" name="PaysPrimaryHeatingCosts" typeRef="boolean">
          <dmn:description>The household must be responsible for its primary heating costs. Households whose heat is included in rent based on their income are not eligible (601.31(2)).</dmn:description>
        </dmn:variable>
        <dmn:invocation id="_9AF0EC68-A213-4CFE-AE02-F3AC9C5FCD58">
