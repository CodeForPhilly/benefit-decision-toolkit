          </dmn:literalExpression>
          <dmn:binding>
            <dmn:parameter id="_C92BC84A-966D-4E4E-9058-BDC56A2727E5" name="situation" typeRef="HouseholdIncomeWithinPovertyGuidelines.tSituation"/>
            <dmn:literalExpression id="_7D1398E8-FA2D-4139-8709-041519E4DD3B">
              <dmn:text>situation</dmn:text>
            </dmn:literalExpression>
          </dmn:binding>
          <dmn:binding>
            <dmn:parameter id="_F867B8DC-6300-4AFD-AC4C-49E887890FD7" name="parameters" typeRef="HouseholdIncomeWithinPovertyGuidelines.tParameters"/>
