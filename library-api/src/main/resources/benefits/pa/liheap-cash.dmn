      <dmn:contextEntry>
        <dmn:variable id="_542181DC-39AB-48CF-8D05-1D4CA90D4D93" name="IncomeAtOrBelow150PercentFpl" typeRef="boolean">
          <dmn:description>Household income must be equal to or less than 150% of the federal poverty guidelines (601.81 to 601.84).</dmn:description>
        </dmn:variable>
        <dmn:invocation id="_1E98745C-46B5-411E-A275-180490DFAD2C">
          <dmn:literalExpression id="_3CEB1E98-C9E0-49F2-AC8F-01074F0FE60A">
