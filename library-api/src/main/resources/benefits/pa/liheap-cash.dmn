  <dmn:decision id="_3461AD0F-7CAF-4772-9B04-D65462BA7E58" name="isEligible">
    <dmn:extensionElements/>
    <dmn:variable id="_0CACA66F-0E3B-49FF-9259-1016EC8D52C3" name="isEligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_6C698CA4-5620-446D-B934-EAF172685499">
      <dmn:requiredDecision href="#_09001E58-B338-46D2-BAC1-A07FE72E264B"/>
    </dmn:informationRequirement>
    <dmn:context id="_B4D41752-983F-479A-B79C-EAF692A9E493">
      <dmn:contextEntry>
        <dmn:variable id="_9524686B-B83A-4239-9FEB-ADF8CD758C8C" name="checksAsList" typeRef="BDT.tBooleanList"/>
        <dmn:literalExpression id="_D12943CB-D2DF-44BF-B90E-521DF1F8401E">
          <dmn:text>// e.g. [true, false, true, null, ...]
for check in (get entries(checks))
return
  check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_4364C7CD-9FD9-405A-8AA4-862FC9DCF3EF" name="result" typeRef="boolean"/>
        <dmn:literalExpression id="_ACCDAD2F-808B-4A9D-914C-A7049F1DF09B">
          <dmn:text>// true if all checks are true
// null if there are any null checks
// false if any check is false
all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_1330A73E-5B0B-43D6-9DCC-808AFC709786">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:decision id="_49B4BAED-3365-4B56-B073-AFF1403FCC15" name="nextSteps">
    <dmn:description>Application instructions and help contacts. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_856D0880-BC94-4860-8695-86284BCF2EBF" name="nextSteps" typeRef="BDT.tNextSteps"/>
    <dmn:literalExpression id="_7F89F253-B345-4603-ADD6-27F7EA4494BD">
      <dmn:text>{
  eligible: {
    applyUrl: "https://www.compass.dhs.pa.gov/home/#/",
    helpUrl: "https://www.pa.gov/agencies/dhs/resources/liheap",
    helpPhone: "1-866-857-7095",
    body: "Apply online through COMPASS during the season, which runs from November 2, 2026 to April 23, 2027. You can also apply at your County Assistance Office.\n\n- Have proof of income for everyone in the household, for the month before you apply or for the past 12 months.\n- Have a recent heating bill, or a statement from your landlord if heat is part of your rent.\n- Apply early. The season can close before April if the money runs out.\n\nFor help, call the LIHEAP hotline at 1-866-857-7095 (TTY 711)."
  },
  ineligible: {
    note: "If you have a heating emergency, such as a shutoff notice or running out of fuel, you may still qualify for LIHEAP Crisis. Call the LIHEAP hotline at 1-866-857-7095."
  }
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:decision id="_5DD9BF44-3A4B-4B00-B92F-B47D4A0376BE" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_F4A2454D-212F-495A-9243-060EBF584B9F" name="reference" typeRef="BDT.tBenefitReference"/>
    <dmn:literalExpression id="_64408FA8-CD0D-48AB-BA9B-AA261D86A85E">
      <dmn:text>{
  explanation: "LIHEAP Cash is a grant that helps households pay for home heating during the winter season. This benefit checks the main rules for the 2026-27 season: the household lives in Pennsylvania, its income is at or below 150% of the federal poverty guidelines, it is responsible for its primary heating costs, someone in it is a U.S. citizen or lawfully admitted non-citizen, and it has not already received a Cash grant this season.",
  administeredBy: {
    name: "Pennsylvania Department of Human Services, through the County Assistance Offices",
    url: "https://www.pa.gov/agencies/dhs/resources/liheap"
  },
  programYear: {
    label: "2026-27 season",
    startDate: date("2026-11-02"),
    endDate: date("2027-04-23")
  },
  sources: [
    {
      title: "Pennsylvania DHS: LIHEAP",
      url: "https://www.pa.gov/agencies/dhs/resources/liheap",
      citation: null,
      checkedOn: date("2026-11-12")
    },
    {
      title: "Pennsylvania LIHEAP FFY 2027 Final State Plan",
      url: "https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf",
      citation: "Appendix B, 601.x eligibility rules: income 601.81 to 601.84; household 601.3 and 601.41; heating responsibility 601.31(2); residency 601.31(3); citizenship 601.31(4); one grant per season 601.43",
      checkedOn: date("2026-11-12")
    },
    {
      title: "HSEA 1 LIHEAP application",
      url: null,
      citation: "Revised 6/26",
      checkedOn: date("2026-11-12")
    }
  ],
  limitations: [
    "Living arrangements that make a household ineligible are not checked: temporary stays, institutions, dorms, fraternity or sorority houses, boarding homes, incarceration, and fleeing felons.",
    "Heating equipment that is not installed or operating to code is not checked, and neither are the rules for recreational vehicles and home businesses.",
    "Household size and income are taken as given. LIHEAP leaves ineligible non-citizens, and people who already got Cash in another household, out of household size but still counts their income.",
    "The applicant may choose the prior month or the prior 12 months as the income period. The screener does not compare the two.",
    "DHS may change the season dates, and the funds can run out before the season closes.",
    "Income limits change each February, when DHS adopts the new federal poverty guidelines."
  ],
  lastReviewed: date("2026-11-12")
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_B16EA3BE-C9D6-4A1E-9067-62CF726E4542" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_D9600676-FE74-4026-B0ED-A711FC7AF277" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:textAnnotation id="_EBBCAEAF-C9FB-4574-8A90-BC00DACDCD4A" textFormat="text/plain">
    <dmn:text>Season dates are documentation only: the rules do not check the screening date. Dated parameters (https://github.com/CodeForPhilly/benefit-decision-toolkit/issues/568) and Periods (https://github.com/CodeForPhilly/benefit-decision-toolkit/issues/550) would let the season and the poverty guideline year follow the screening date.</dmn:text>
  </dmn:textAnnotation>
  <dmn:association id="_FCD2EFD9-13BC-4D1A-BAD6-F875E5B999B1" associationDirection="None">
    <dmn:sourceRef href="#_09001E58-B338-46D2-BAC1-A07FE72E264B"/>
    <dmn:targetRef href="#_EBBCAEAF-C9FB-4574-8A90-BC00DACDCD4A"/>
  </dmn:association>
  <dmn:textAnnotation id="_8DD48254-3CF5-4D15-807C-CFEE559F4CB5" textFormat="text/plain">
    <dmn:text>householdSize and householdIncome are used as given. The screener has to apply LIHEAP's rules for whose income counts (601.81 to 601.84) and who is left out of household size (601.41(1)).</dmn:text>
  </dmn:textAnnotation>
