  <dmn:decision id="_AF08C0D6-7E85-4BCD-86FB-C9206DEFE65C" name="isEligible">
    <dmn:extensionElements/>
    <dmn:variable id="_87C52459-7B26-4C7D-BD5D-BA22A399E6AF" name="isEligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_139FF6EF-3A7F-445D-B8C3-5B08979F97FC">
      <dmn:requiredDecision href="#_9DC20E10-CA45-4DDA-A196-EE5DA91C380F"/>
    </dmn:informationRequirement>
    <dmn:context id="_0F02A27B-78FA-48A8-99F4-3EB3B54857C3">
      <dmn:contextEntry>
        <dmn:variable id="_5485A409-EFDC-47CD-89B9-0E86A6E95769" name="checksAsList" typeRef="BDT.tBooleanList"/>
        <dmn:literalExpression id="_ED0F0CEF-6306-4450-A32F-2B1B82CFB060">
          <dmn:text>// e.g. [true, false, true, null, ...]
for check in (get entries(checks))
return
  check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_7CFB5E0D-215B-4A6B-959D-A2A5FB771AB7" name="result" typeRef="boolean"/>
        <dmn:literalExpression id="_3475BC3E-963A-4FC7-8731-B978F4DD43A6">
          <dmn:text>// true if all checks are true
// null if there are any null checks
// false if any check is false
all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_096EBB4C-B41B-410B-B893-9A78AEAC1B73">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:decision id="_F0104930-AA4D-4BD9-866B-AC9A093B36D8" name="nextSteps">
    <dmn:description>Application instructions and help contacts. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_6640C28F-2427-4C5C-9F23-C2B94E7713EC" name="nextSteps" typeRef="BDT.tNextSteps"/>
    <dmn:context id="_61B507A3-8A0C-47BF-9A70-F777BB2DAB21" typeRef="BDT.tNextSteps">
      <dmn:contextEntry>
        <dmn:variable id="_89096392-2605-4CD7-BEB5-F0AF6432CA7F" name="eligible"/>
        <dmn:context id="_CBCB4B01-1B13-4DC4-9C29-4AA9F3B25DFD">
          <dmn:contextEntry>
            <dmn:variable id="_E438F5D1-4F5D-4DAE-AFF6-93193BDA950B" name="applyUrl" typeRef="string"/>
            <dmn:literalExpression id="_0DD50589-E5D9-43AE-B3C4-B240027004E4" typeRef="string">
              <dmn:text>"https://www.compass.dhs.pa.gov/home/#/"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_39F6FB5A-0C4F-4850-B59A-4B36840D41F8" name="helpUrl" typeRef="string"/>
            <dmn:literalExpression id="_B6E585BC-2A0A-4D7D-AB07-ABC1EA1BDF89" typeRef="string">
              <dmn:text>"https://www.pa.gov/agencies/dhs/resources/liheap"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_E0D15166-58B7-489F-A750-D763542D1632" name="helpPhone" typeRef="string"/>
            <dmn:literalExpression id="_CC85FC11-09F1-45A1-97A5-407246EF1942" typeRef="string">
              <dmn:text>"1-866-857-7095"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_C900C6E2-2D4A-456B-9B37-35DEB7DB5890" name="body" typeRef="string"/>
            <dmn:literalExpression id="_908504CD-AA80-44D8-839E-5B2BC79183D9" typeRef="string">
              <dmn:text>"Apply online through COMPASS during the season, which runs from November 2, 2026 to April 23, 2027. You can also apply at your County Assistance Office.\n\n- Have proof of income for everyone in the household, for the month before you apply or for the past 12 months.\n- Have a recent heating bill, or a statement from your landlord if heat is part of your rent.\n- Apply early. The season can close before April if the money runs out.\n\nFor help, call the LIHEAP hotline at 1-866-857-7095 (TTY 711)."</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
        </dmn:context>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_FB10BFEC-848B-4815-BFDF-3A9859F150D6" name="ineligible"/>
        <dmn:context id="_C73E4384-9780-4CFF-B288-DE02760E9086">
          <dmn:contextEntry>
            <dmn:variable id="_98598780-814D-4D2F-9A09-620E2FCECB0D" name="note" typeRef="string"/>
            <dmn:literalExpression id="_9370DB48-A2DB-42E2-AFD8-CB854CD6A6A4" typeRef="string">
              <dmn:text>"If you have a heating emergency, such as a shutoff notice or running out of fuel, you may still qualify for LIHEAP Crisis. Call the LIHEAP hotline at 1-866-857-7095."</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
        </dmn:context>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:decision id="_8D6F60F0-2975-4E02-A998-BEBB606FDFE6" name="reference">
    <dmn:description>Reference shown in the builder, the docs site and the OpenAPI spec. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_05ADF2D4-A27C-4537-97E6-76614588AEE3" name="reference" typeRef="BDT.tBenefitReference"/>
    <dmn:context id="_B5248AAD-F4EC-4F63-99BD-6504B8668318" typeRef="BDT.tBenefitReference">
      <dmn:contextEntry>
        <dmn:variable id="_E4400C8D-1748-4718-B782-B59CDD8B958D" name="explanation" typeRef="string"/>
        <dmn:literalExpression id="_F3A127BA-6AE1-415C-838A-881AA4284DE9" typeRef="string">
          <dmn:text>"LIHEAP Cash is a grant that helps households pay for home heating during the winter season. This benefit checks the main rules for the 2026-27 season: the household lives in Pennsylvania, its income is at or below 150% of the federal poverty guidelines, it is responsible for its primary heating costs, someone in it is a U.S. citizen or lawfully admitted non-citizen, and it has not already received a Cash grant this season."</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_1ADCEBB4-EFA5-4E5B-BE25-800091B36DEC" name="administeredBy"/>
        <dmn:context id="_9C2166BC-915F-480D-BB97-5BD041EC0F2B">
          <dmn:contextEntry>
            <dmn:variable id="_D234B808-C568-4241-B1FB-A318E554B12C" name="name" typeRef="string"/>
            <dmn:literalExpression id="_73759EE0-5228-439F-832B-AB1E7F5A463A" typeRef="string">
              <dmn:text>"Pennsylvania Department of Human Services, through the County Assistance Offices"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_BDDFDBD1-B9C1-4C7C-9C47-3B3666C35A22" name="url" typeRef="string"/>
            <dmn:literalExpression id="_EB710E5A-7ADB-4F03-A663-F5EC46CDF978" typeRef="string">
              <dmn:text>"https://www.pa.gov/agencies/dhs/resources/liheap"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
        </dmn:context>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_05F24557-0C84-4984-BE09-79B0A041F42F" name="programYear"/>
        <dmn:context id="_7EA0AC79-89D0-4551-B552-29BB4D8C9CD1">
          <dmn:contextEntry>
            <dmn:variable id="_1FEDEA09-893F-462E-AEF8-26A3484988F7" name="label" typeRef="string"/>
            <dmn:literalExpression id="_AE5291C2-E5F6-4267-94FE-263DF2DFF589" typeRef="string">
              <dmn:text>"2026-27 season"</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_8F87BA67-E863-4DFF-AC79-B2AA649B1C74" name="startDate" typeRef="date"/>
            <dmn:literalExpression id="_687519FC-23F4-4FB0-B503-E4D5589C3B70" typeRef="date">
              <dmn:text>date("2026-11-02")</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
          <dmn:contextEntry>
            <dmn:variable id="_28776F22-5559-4313-8DEF-E1F798A2C374" name="endDate" typeRef="date"/>
            <dmn:literalExpression id="_1A35C3E5-98B9-466D-95CF-852F2AB8D255" typeRef="date">
              <dmn:text>date("2027-04-23")</dmn:text>
            </dmn:literalExpression>
          </dmn:contextEntry>
        </dmn:context>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_C3C308D6-D7A1-4B06-AAFB-16E8E1DACC2D" name="sources" typeRef="BDT.tReferenceSourceList"/>
        <dmn:list id="_4D2015A1-CAD3-444F-8964-2148864C11CB" typeRef="BDT.tReferenceSourceList">
          <dmn:context id="_3AC9914B-1C76-43EA-8905-C967F95EDE73" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_61DEBE9B-86B9-400B-8EAE-767F06A74048" name="title" typeRef="string"/>
              <dmn:literalExpression id="_A4DE1379-E597-497B-A19A-97ED15723086" typeRef="string">
                <dmn:text>"Pennsylvania DHS: LIHEAP"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_5468E03D-A1A4-466C-A58B-05AB15CA288B" name="url" typeRef="string"/>
              <dmn:literalExpression id="_B0261D7F-5F32-40E7-8DB5-C0899B08F7A1" typeRef="string">
                <dmn:text>"https://www.pa.gov/agencies/dhs/resources/liheap"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_73521FF8-D24B-4651-98BA-14FB6A5ECCE4" name="citation" typeRef="string"/>
              <dmn:literalExpression id="_3E661152-73F1-4B60-8F86-4D594AA41151" typeRef="string">
                <dmn:text>null</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_F1F411BC-77F5-40BA-ADDE-5ECD07844165" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_664D9530-7B25-40E7-9DE1-A9DD24BC2808" typeRef="date">
                <dmn:text>date("2026-11-12")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
          <dmn:context id="_133140E4-BBFC-44AD-9590-6B0AF8C8FC6D" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_8F0B4067-0BB7-4B7C-88CA-4DBF2BFE9D5F" name="title" typeRef="string"/>
              <dmn:literalExpression id="_84723F1F-DDFB-4494-981F-74F45F7D3AAE" typeRef="string">
                <dmn:text>"Pennsylvania LIHEAP FFY 2027 Final State Plan"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_1DFE7987-47E3-4EAE-9AEE-228F0BF8816D" name="url" typeRef="string"/>
              <dmn:literalExpression id="_7EE32CDA-9354-4746-B766-86BEE297DFA2" typeRef="string">
                <dmn:text>"https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_6FE74CB4-C462-46AC-86A2-22B4E375C096" name="citation" typeRef="string"/>
              <dmn:literalExpression id="_76BC7C01-7923-4BCF-86A3-1AB0982FEC05" typeRef="string">
                <dmn:text>"Appendix B, 601.x eligibility rules: income 601.81 to 601.84; household 601.3 and 601.41; heating responsibility 601.31(2); residency 601.31(3); citizenship 601.31(4); one grant per season 601.43"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_56AB648D-AB12-4FCC-BC6A-0F8198621487" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_87ED4C5C-B13C-45C7-8385-8AF98E0597E0" typeRef="date">
                <dmn:text>date("2026-11-12")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
          <dmn:context id="_528B52BC-F16C-40BE-B7B7-EC6BAE978A31" typeRef="BDT.tReferenceSource">
            <dmn:contextEntry>
              <dmn:variable id="_36C34C4E-7366-495D-8EB7-002974046EE8" name="title" typeRef="string"/>
              <dmn:literalExpression id="_C8A4442D-6574-4B25-8851-07667562D582" typeRef="string">
                <dmn:text>"HSEA 1 LIHEAP application"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_A358FA6E-7EBC-4B6C-8753-32EDFDAEDA64" name="url" typeRef="string"/>
              <dmn:literalExpression id="_590248CB-7881-41A5-9506-CDA5280983D3" typeRef="string">
                <dmn:text>null</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_753AA8B2-8E44-461F-A1BD-48B9BE551D99" name="citation" typeRef="string"/>
              <dmn:literalExpression id="_7684D865-CD97-4348-8770-C6AB1CFED15E" typeRef="string">
                <dmn:text>"Revised 6/26"</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
            <dmn:contextEntry>
              <dmn:variable id="_B2B6F4CC-7951-4396-8E13-B6F2389152FE" name="checkedOn" typeRef="date"/>
              <dmn:literalExpression id="_A619E5C3-096D-472B-A74E-9F5B06E8AFA8" typeRef="date">
                <dmn:text>date("2026-11-12")</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_F884814E-7EE6-4F39-A23B-5E78F3D0ED7C" name="limitations" typeRef="BDT.tStringList"/>
        <dmn:list id="_855E83F4-27C5-4B26-AB2D-C0352B86C7B3" typeRef="BDT.tStringList">
          <dmn:literalExpression id="_09E0301E-B533-46FF-810A-D6782D977A29" typeRef="string">
            <dmn:text>"Living arrangements that make a household ineligible are not checked: temporary stays, institutions, dorms, fraternity or sorority houses, boarding homes, incarceration, and fleeing felons."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_CA5D2BE7-007A-480C-8441-86AF5735AA9A" typeRef="string">
            <dmn:text>"Heating equipment that is not installed or operating to code is not checked, and neither are the rules for recreational vehicles and home businesses."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_1BBF3EA3-3392-45DC-9438-BE266E31D9EC" typeRef="string">
            <dmn:text>"Household size and income are taken as given. LIHEAP leaves ineligible non-citizens, and people who already got Cash in another household, out of household size but still counts their income."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_0BD35AD6-B521-4AAC-BB66-B8E5DE82F445" typeRef="string">
            <dmn:text>"The applicant may choose the prior month or the prior 12 months as the income period. The screener does not compare the two."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_AB63A316-B164-45B6-BB93-A60746872CF9" typeRef="string">
            <dmn:text>"DHS may change the season dates, and the funds can run out before the season closes."</dmn:text>
          </dmn:literalExpression>
          <dmn:literalExpression id="_9243DE09-6BBA-4EBE-AB67-1E2C99E987C8" typeRef="string">
            <dmn:text>"Income limits change each February, when DHS adopts the new federal poverty guidelines."</dmn:text>
          </dmn:literalExpression>
        </dmn:list>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_8C0D69F2-EE63-41FF-8263-828B85A08133" name="lastReviewed" typeRef="date"/>
        <dmn:literalExpression id="_8927F054-BA34-4C8D-9FAF-DC52FA662A4C" typeRef="date">
          <dmn:text>date("2026-11-12")</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_9C9FC140-0123-4A0F-A07E-1A9EB1EE6BA3" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_0509D05F-ACF4-4C43-824B-97B75C9167A1" name="situation" typeRef="tSituation"/>
  </dmn:inputData>
  <dmn:textAnnotation id="_E541708A-7929-4B70-9AE0-0C8C5BB31B1A" textFormat="text/plain">
    <dmn:text>Season dates are documentation only: the rules do not check the screening date. Dated parameters (https://github.com/CodeForPhilly/benefit-decision-toolkit/issues/568) and Periods (https://github.com/CodeForPhilly/benefit-decision-toolkit/issues/550) would let the season and the poverty guideline year follow the screening date.</dmn:text>
  </dmn:textAnnotation>
  <dmn:association id="_E0AF9513-F089-46A6-BB41-6EC9E9C611DC" associationDirection="None">
    <dmn:sourceRef href="#_9DC20E10-CA45-4DDA-A196-EE5DA91C380F"/>
    <dmn:targetRef href="#_E541708A-7929-4B70-9AE0-0C8C5BB31B1A"/>
  </dmn:association>
  <dmn:textAnnotation id="_99D33F46-FCF1-4A43-85C8-04F10261E904" textFormat="text/plain">
    <dmn:text>householdSize and householdIncome are used as given. The screener has to apply LIHEAP's rules for whose income counts (601.81 to 601.84) and who is left out of household size (601.41(1)).</dmn:text>
  </dmn:textAnnotation>
  <dmn:association id="_1E3A5728-124E-478C-B725-C5ED92083AF1" associationDirection="None">
    <dmn:sourceRef href="#_9DC20E10-CA45-4DDA-A196-EE5DA91C380F"/>
    <dmn:targetRef href="#_99D33F46-FCF1-4A43-85C8-04F10261E904"/>
  </dmn:association>
