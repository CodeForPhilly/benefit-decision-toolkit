          <dmn:description>LIHEAP Cash is for households that permanently live in Pennsylvania (601.31(3)).</dmn:description>
        </dmn:variable>
        <dmn:invocation id="_7BF53C6F-670F-48F9-9190-A562F9C174A6">
          <dmn:literalExpression id="_9190F4B7-92FC-4150-A3CC-B53467AFDE90">
