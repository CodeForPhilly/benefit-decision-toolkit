#!/usr/bin/env bash
# Prepare reviewable release files; leave committing, tagging and pushing to the caller.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
if [ "$#" -ne 1 ] || ! [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Usage: $0 <MAJOR.MINOR.PATCH>" >&2
    exit 1
fi
if ! command -v mvn >/dev/null 2>&1; then
    cd "$REPO_ROOT"
    exec devbox run -- "$SCRIPT_DIR/prepare-release" "$@"
fi
cd "$REPO_ROOT/library-api"
mvn -q versions:set -DnewVersion="$1" -DgenerateBackupPoms=false
CURRENT_VERSION=$(mvn help:evaluate -Dexpression=project.version -q -DforceStdout)
if [ "$CURRENT_VERSION" != "$1" ]; then
    echo "Maven version update failed: expected $1, got $CURRENT_VERSION" >&2
    exit 1
fi
mvn test -Dtest=OpenApiSnapshotTest -Dopenapi.snapshot.update=true
python3 "$SCRIPT_DIR/check-release-consistency.py" --sync-example
python3 "$SCRIPT_DIR/check-release-consistency.py"
mvn test
(cd "$REPO_ROOT/builder-api" && mvn test -Dtest=ExampleScreenerImportServiceTest,ExampleScreenerSeedTest,ScreenerTransferServiceTest)
echo "Release $1 prepared and validated. Review git diff before committing or tagging."
