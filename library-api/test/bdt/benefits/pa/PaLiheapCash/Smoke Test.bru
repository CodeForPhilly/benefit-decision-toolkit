meta {
  name: Smoke Test
  type: http
  seq: 1
}

post {
  url: {{host}}/benefits/pa/liheap-cash
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "simpleChecks": {
        "livesInPennsylvania": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq null
  res.body.checks.LivesInPennsylvania: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
