meta {
  name: Eligible with five year increase
  type: http
  seq: 13
}

post {
  url: {{host}}/benefits/pa/phl/loop
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "OtherBenefit"
        }
      ],
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true,
        "taxDelinquent": false,
        "disqualifyingTaxAbatement": false
      },
      "householdIncome": 100000,
      "householdSize": 1,
      "yearsOwnerOccupied": 10,
      "propertyAssessment": 175000,
      "previousYearPropertyAssessment": 175000,
      "lowestPropertyAssessmentLastFiveYears": 100000
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
  res.body.checks.AssessmentIncrease: eq true
}
