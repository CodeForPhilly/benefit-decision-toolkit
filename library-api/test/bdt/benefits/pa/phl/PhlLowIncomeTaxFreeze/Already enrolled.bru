meta {
  name: Already enrolled
  type: http
  seq: 4
}

post {
  url: {{host}}/benefits/pa/phl/low-income-tax-freeze
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "PhlLowIncomeTaxFreeze"
        }
      ],
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true,
        "isMarried": false
      },
      "householdIncome": 33500
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq false
  res.body.checks.NotAlreadyEnrolled: eq false
}
