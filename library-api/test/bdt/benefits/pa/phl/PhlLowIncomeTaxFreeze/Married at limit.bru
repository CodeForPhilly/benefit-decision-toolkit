  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "OtherBenefit"
        }
      ],
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true
      },
      "applicantAndSpouseIncome": 41500,
      "relationships": [
        {
          "type": "spouse",
          "personId": "p1",
          "relatedPersonId": "p2"
        }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
