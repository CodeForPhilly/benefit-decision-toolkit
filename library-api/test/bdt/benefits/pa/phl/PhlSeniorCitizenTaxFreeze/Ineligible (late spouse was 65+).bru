meta {
  name: Ineligible (late spouse was 65+)
  type: http
  seq: 4
}

post {
  url: {{host}}/benefits/pa/phl/senior-citizen-tax-freeze
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true,
        "lateSpouseWasAtLeast65": true
      },
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2005-10-01"
        }
      ],
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "PhlHomesteadExemption"
        }
      ],
      "relationships": []
    }
  }
}

assert {
  res.body.isEligible: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
