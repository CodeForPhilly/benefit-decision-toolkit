meta {
  name: Age Req Fail with no spouse
  type: http
  seq: 6
}

post {
  url: {{host}}/benefits/pa/phl/senior-citizen-tax-freeze
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2026-09-01"
        }
      ],
      "relationships": []
    }
  }
}

assert {
  res.body.isEligible: eq false
  res.body.checks.MeetsAgeRequirement: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
