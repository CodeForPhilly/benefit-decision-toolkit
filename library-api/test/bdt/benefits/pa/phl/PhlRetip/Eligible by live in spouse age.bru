meta {
  name: Eligible by live in spouse age
  type: http
  seq: 7
}

post {
  url: {{host}}/benefits/pa/phl/retip
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "OtherBenefit"
        }
      ],
      "simpleChecks": {
        "spouseLivesInHousehold": true,
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true
      },
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2000-01-01"
        },
        {
          "id": "p2",
          "dateOfBirth": "1940-01-01"
        }
      ],
      "relationships": [
        {
          "personId": "p1",
          "relatedPersonId": "p2",
          "type": "spouse"
        }
      ],
      "householdIncome": 1000000,
      "householdSize": 2
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
  res.body.checks.MeetsAgeOrIncomeRequirement: eq true
}
