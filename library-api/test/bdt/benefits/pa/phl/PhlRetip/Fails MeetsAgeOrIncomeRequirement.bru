meta {
  name: Fails MeetsAgeOrIncomeRequirement
  type: http
  seq: 5
}

post {
  url: {{host}}/benefits/pa/phl/retip
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "OtherBenefit"
        }
      ],
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true
      },
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2000-01-01"
        }
      ],
      "relationships": [],
      "householdIncome": 100000,
      "householdSize": 1
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq false
  res.body.checks.MeetsAgeOrIncomeRequirement: eq false
}
