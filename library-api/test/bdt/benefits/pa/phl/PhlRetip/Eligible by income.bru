meta {
  name: Eligible by income
  type: http
  seq: 6
}

post {
  url: {{host}}/benefits/pa/phl/retip
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "OtherBenefit"
        }
      ],
      "simpleChecks": {
        "ownerOccupant": true,
        "livesInPhiladelphiaPa": true
      },
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2000-01-01"
        }
      ],
      "relationships": [],
      "householdSize": 1,
      "householdIncome": 30000
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
  res.body.checks.MeetsAgeOrIncomeRequirement: eq true
}
