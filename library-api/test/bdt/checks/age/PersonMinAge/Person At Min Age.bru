meta {
  name: Person At Min Age
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/age/person-min-age
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2020-01-01"
        }
      ]
    },
    "parameters": {
      "personId": "p1",
      "asOfDate": "2024-01-01",
      "minAge": 4
    }
  }
}

assert {
  res.body.checkResult: eq true
}

docs {
  A person born on January 1, 2020 turns 4 on January 1, 2024, so they meet a minimum age of 4 on that date.
}

settings {
  encodeUrl: true
  timeout: 0
}
