meta {
  name: Pass
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/age/applicant-or-spouse-min-age
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1940-01-01"
        }
      ]
    },
    "parameters": {
      "minAge": 65
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
