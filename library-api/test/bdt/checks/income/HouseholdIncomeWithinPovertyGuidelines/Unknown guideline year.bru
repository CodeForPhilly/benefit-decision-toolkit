meta {
  name: Unknown guideline year
  type: http
  seq: 11
}

post {
  url: {{host}}/checks/income/household-income-within-poverty-guidelines
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdSize": 1,
      "householdIncome": 1000
    },
    "parameters": {
      "percent": 150,
      "guidelineYear": 2019
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq null
}

settings {
  encodeUrl: true
  timeout: 0
}
