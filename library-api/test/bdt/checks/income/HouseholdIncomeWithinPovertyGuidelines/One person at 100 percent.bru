meta {
  name: One person at 100 percent
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/income/household-income-within-poverty-guidelines
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdSize": 1,
      "householdIncome": 15960
    },
    "parameters": {
      "percent": 100,
      "guidelineYear": 2026
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
