meta {
  name: Two people at 150 percent
  type: http
  seq: 3
}

post {
  url: {{host}}/checks/income/household-income-within-poverty-guidelines
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdSize": 2,
      "householdIncome": 32460
    },
    "parameters": {
      "percent": 150,
      "guidelineYear": 2026
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
