meta {
  name: Size 1 below cap
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/income/loop-income
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdIncome": 103049.99,
      "householdSize": 1
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
docs {
  One person with $103,049.99 in yearly income is just below the limit, so the check passes.
}

