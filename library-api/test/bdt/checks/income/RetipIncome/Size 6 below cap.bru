meta {
  name: Size 6 below cap
  type: http
  seq: 14
}

post {
  url: {{host}}/checks/income/retip-income
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdIncome": 71199.99,
      "householdSize": 6
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
