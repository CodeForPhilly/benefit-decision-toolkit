meta {
  name: Size 8 below cap
  type: http
  seq: 18
}

post {
  url: {{host}}/checks/income/retip-income
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdIncome": 80999.99,
      "householdSize": 8
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
