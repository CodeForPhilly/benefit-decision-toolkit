meta {
  name: Zero income
  type: http
  seq: 7
}

post {
  url: {{host}}/checks/income/tax-freeze-income
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdIncome": 0,
      "simpleChecks": {
        "isMarried": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
