meta {
  name: Married at limit
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/income/tax-freeze-income
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "householdIncome": 41500,
      "simpleChecks": {
        "isMarried": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
