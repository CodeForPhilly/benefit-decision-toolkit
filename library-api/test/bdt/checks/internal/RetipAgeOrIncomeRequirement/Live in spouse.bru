meta {
  name: Live in spouse
  type: http
  seq: 6
}

post {
  url: {{host}}/checks/internal/retip-age-or-income-requirement
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "2000-01-01"
        },
        {
          "id": "p2",
          "dateOfBirth": "1940-01-01"
        }
      ],
      "relationships": [
        {
          "personId": "p1",
          "relatedPersonId": "p2",
          "type": "spouse"
        }
      ],
      "simpleChecks": {
        "spouseLivesInHousehold": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
