meta {
  name: Senior above income limit
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/internal/retip-age-or-income-requirement
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1940-01-01"
        }
      ],
      "householdSize": 1,
      "householdIncome": 1000000
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
