meta {
  name: Pass
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/citizenship/household-has-citizen-or-eligible-noncitizen
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "householdHasCitizenOrEligibleNoncitizen": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  Someone in the household is a U.S. citizen or lawfully admitted non-citizen, so the check
  passes.
}

settings {
  encodeUrl: true
  timeout: 0
}
