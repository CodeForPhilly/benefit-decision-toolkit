meta {
  name: Enrolled in Bogus Benefit
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/enrollment/person-enrolled-in-benefit
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1"
        }
      ],
      "enrollments": [
        {
          "personId": "p1",
          "benefit": "bogus"
        }
      ]
    },
    "parameters": {
      "personId": "p1",
      "benefit": "bogus"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  The enrollments list shows person p1 in the named benefit, so the check passes.
}

settings {
  encodeUrl: true
  timeout: 0
}
