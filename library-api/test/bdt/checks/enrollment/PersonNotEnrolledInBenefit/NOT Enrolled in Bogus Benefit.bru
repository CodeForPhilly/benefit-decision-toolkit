meta {
  name: NOT Enrolled in Bogus Benefit
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/enrollment/person-not-enrolled-in-benefit
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1"
        }
      ],
      "enrollments": [
        {
          "personId": "p2",
          "benefit": "bogus"
        }
      ]
    },
    "parameters": {
      "personId": "p1",
      "benefit": "bogus"
    }
  }
}

assert {
  res.body.checkResult: eq true
}

docs {
  Only a different person is enrolled in the named benefit, so the check passes for person p1.
}

settings {
  encodeUrl: true
  timeout: 0
}
