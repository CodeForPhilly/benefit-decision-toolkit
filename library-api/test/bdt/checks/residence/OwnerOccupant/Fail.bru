meta {
  name: Fail
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/residence/owner-occupant
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "ownerOccupant": false
      }
    }
  }
}

assert {
  res.body.checkResult: eq false
  res.status: eq 200
}
docs {
  The person does not own and live in the home, so the check fails.
}

