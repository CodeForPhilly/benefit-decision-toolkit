meta {
  name: Five year only
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/residence/property-assessment-increase
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "propertyAssessment": 175000,
      "lowestPropertyAssessmentLastFiveYears": 100000
    },
    "parameters": {
      "oneYearPercent": 50,
      "fiveYearPercent": 75
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
