meta {
  name: Longer residency
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/residence/min-years-owner-occupant
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "yearsOwnerOccupied": 20
    },
    "parameters": {
      "minYears": 10
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
