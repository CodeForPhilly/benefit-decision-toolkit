meta {
  name: Fail
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/residence/tax-delinquent
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "taxDelinquent": false
      }
    }
  }
}

assert {
  res.body.checkResult: eq false
  res.status: eq 200
}
docs {
  The owner's taxes are current, so the check fails.
}

