meta {
  name: Payment plan
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/residence/property-taxes-current-or-payment-plan
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "taxDelinquent": true,
        "propertyTaxPaymentPlan": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
