<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://bdt.codeforphilly.org/examples/wants-extra-cash" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="definitions-wants-extra-cash" name="Would like extra cash" namespace="https://bdt.codeforphilly.org/examples/wants-extra-cash">
  <dmn:description>A parameterized custom check for the fictional Philly Cash benefit. expectedAnswer is configured as true. Leave the answer blank in Preview to see Need more information.</dmn:description>
  <dmn:itemDefinition id="parameters-type" name="tParameters"><dmn:itemComponent id="answer-field" name="expectedAnswer"><dmn:typeRef>boolean</dmn:typeRef></dmn:itemComponent></dmn:itemDefinition>
  <dmn:inputData id="input" name="wantsExtraCash"><dmn:variable id="input-variable" name="wantsExtraCash" typeRef="boolean"/></dmn:inputData>
  <dmn:inputData id="parameters" name="parameters"><dmn:variable id="parameters-variable" name="parameters" typeRef="tParameters"/></dmn:inputData>
  <dmn:decision id="decision" name="Would like extra cash"><dmn:description>A parameterized custom check for the fictional Philly Cash benefit. expectedAnswer is configured as true. Leave the answer blank in Preview to see Need more information.</dmn:description><dmn:variable id="decision-variable" name="Would like extra cash" typeRef="boolean"/>
    <dmn:informationRequirement id="requires-input"><dmn:requiredInput href="#input"/></dmn:informationRequirement>
    <dmn:informationRequirement id="requires-parameters"><dmn:requiredInput href="#parameters"/></dmn:informationRequirement>
    <dmn:literalExpression id="expression"><dmn:text>if wantsExtraCash = null then null else wantsExtraCash = parameters.expectedAnswer</dmn:text></dmn:literalExpression></dmn:decision>
  <dmn:textAnnotation id="annotation"><dmn:text>This is a teaching example, not a real cash program. expectedAnswer belongs to the benefit configuration, not the applicant form. Publish an edited check as a new version and use the version picker to update a benefit.</dmn:text></dmn:textAnnotation>
  <dmn:association id="association" associationDirection="None"><dmn:sourceRef href="#annotation"/><dmn:targetRef href="#decision"/></dmn:association>
  <dmndi:DMNDI><dmndi:DMNDiagram id="diagram" name="DRG">
    <dmndi:DMNShape id="shape-decision" dmnElementRef="decision"><dc:Bounds x="220" y="120" width="220" height="80"/><dmndi:DMNLabel/></dmndi:DMNShape>
    <dmndi:DMNShape id="shape-annotation" dmnElementRef="annotation"><dc:Bounds x="530" y="100" width="370" height="180"/><dmndi:DMNLabel/></dmndi:DMNShape>
    <dmndi:DMNShape id="shape-input" dmnElementRef="input"><dc:Bounds x="120" y="360" width="220" height="80"/><dmndi:DMNLabel/></dmndi:DMNShape>
    <dmndi:DMNShape id="shape-parameters" dmnElementRef="parameters"><dc:Bounds x="420" y="360" width="220" height="80"/><dmndi:DMNLabel/></dmndi:DMNShape>
    <dmndi:DMNEdge id="edge-input" dmnElementRef="requires-input"><di:waypoint x="230" y="360"/><di:waypoint x="330" y="200"/></dmndi:DMNEdge>
    <dmndi:DMNEdge id="edge-parameters" dmnElementRef="requires-parameters"><di:waypoint x="530" y="360"/><di:waypoint x="330" y="200"/></dmndi:DMNEdge>
    <dmndi:DMNEdge id="edge-annotation" dmnElementRef="association"><di:waypoint x="530" y="160"/><di:waypoint x="440" y="160"/></dmndi:DMNEdge>
  </dmndi:DMNDiagram></dmndi:DMNDI>
</dmn:definitions>
