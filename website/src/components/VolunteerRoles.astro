---
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ActionButton from "./ActionButton.astro";
const roles = await getCollection("roles");
---

<section id="volunteer-roles" class="bg-white">
  <div
    class="flex flex-col gap-6 py-12 md:py-18 sm:px-6 px-3 max-w-[130ch] mx-auto"
  >
    <h2>Volunteer Roles</h2>
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 sm:gap-6 gap-4">
      {
        roles.map(async (role) => {
          const { Content } = await render(role);
          return (
            <li class=" bg-bg border border-card-border rounded-2xl sm:p-6 px-3 py-4 min-w-30 role-card flex flex-col gap-3 justify-between">
              <div class="flex flex-col gap-3">
                <h3>{role.data.title}</h3>
                <p>{role.data.brief}</p>
              </div>
              <details name="roles">
                <summary class="[&::marker]:content-[''] mx-auto cursor-pointer select-none text-center font-bold border border-heading/30 rounded-lg w-fit px-4 py-2 bg-white/30">
                  <span class="show-more">Show more</span>
                  <span class="show-less hidden">Show less</span>
                </summary>
                <div class="prose py-6 prose-li:text-black prose-li:marker:text-black">
                  <Content />
                </div>
                <div class="w-fit">
                  <a
                    href="https://codeforphilly.org/projects/dmn_benefit_toolbox-including_the_philly_property_tax_relief_screener"
                    target="_blank"
                  >
                    <ActionButton>Join Our Team</ActionButton>
                  </a>
                </div>
              </details>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  details[open] .show-more {
    display: none;
  }

  details[open] .show-less {
    display: inline;
  }

  .role-card {
    scroll-margin-top: 1.5rem;
  }

  .role-card:has(details[open]) {
    grid-column: 1 / -1;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>(".role-card details")
    .forEach((details) => {
      details.addEventListener("toggle", () => {
        if (details.open) {
          details.closest(".role-card")?.scrollIntoView({
            block: "start",
          });
        }
      });
    });
</script>
