---
import { getCollection } from "astro:content";

const team = (await getCollection("team")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const teamSorted: typeof team = [];
team.forEach((teamMember) => {
  if (teamMember.data.role.includes("Co-Lead")) {
    teamSorted.push(teamMember);
  }
});
team.forEach((teamMember) => {
  if (!teamMember.data.role.includes("Co-Lead")) {
    teamSorted.push(teamMember);
  }
});
import { Image } from "astro:assets";
---

<section id="team" class="max-w-[130ch] mx-auto py-12 md:py-18 px-3">
  <h1 class="mb-9 lg:mb-12 text-4xl">Meet The Team</h1>
  <ul
    class="flex flex-wrap gap-x-9 sm:gap-x-6 sm:gap-y-12 gap-y-9 justify-center"
  >
    {
      teamSorted.map(async (teamMember) => {
        return (
          <li class="sm:w-60 w-30">
            <div class="text-center flex flex-col gap-2 sm:gap-3">
              <Image
                src={teamMember.data.photo}
                alt={teamMember.data.photoAlt}
                width={500}
                height={500}
                class="w-40 mx-auto rounded-full border border-bdt-blue/33 p-1 mb-2"
              />
              <h3>{teamMember.data.name}</h3>
              <p class="font-medium">{teamMember.data.role}</p>
              {teamMember.data.link && (
                <p>
                  <a
                    href={teamMember.data.link}
                    target="_blank"
                    class="underline text-bdt-blue"
                  >
                    Connect ↗
                  </a>
                </p>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
