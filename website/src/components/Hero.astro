---
import { Content } from "../assets/text/Hero.md";
import ActionButton from "./ActionButton.astro";
import CheckGraphic from "../assets/backgrounds/check-graphic.png";
import { Image } from "astro:assets";
---

<section
  id="hero"
  class="py-6 px-3 md:px-6 pb-24 bg-white bg-[url(../assets/backgrounds/check-pattern.webp)] bg-size-[auto_900px]"
>
  <div class="max-w-[130ch] mx-auto mt-20 flex justify-between gap-12">
    <div>
      <div
        class="prose prose-p:text-black prose-p:max-w-[65ch] prose-headings:text-heading prose-headings:text-left prose-headings:text-5xl! prose-p:text-xl! prose-p:leading-7! max-w-none"
      >
        <Content />
      </div>
      <div class="w-fit">
        <a href="/#projects">
          <ActionButton>Learn more</ActionButton>
        </a>
      </div>
    </div>
    <div class="w-2/3 max-w-66 hidden md:block">
      <Image src={CheckGraphic} alt="Check marks" />
    </div>
  </div>
</section>
