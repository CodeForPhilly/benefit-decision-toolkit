---
import { Content } from "../assets/text/Hero.md";
---

<section id="hero" class="py-6 px-3 bg-white">
  <div class="max-w-[130ch] mx-auto mt-20">
    <div
      class="prose prose-p:text-black prose-headings:text-heading prose-headings:text-left prose-headings:text-5xl! prose-p:text-xl! prose-p:leading-7! prose-headings:max-w-2/3"
    >
      <Content />
    </div>
    <a href="/#projects">
      <div
        class="mt-6 w-fit px-6 py-3 bg-button rounded-lg font-serif text-xl shadow-md"
      >
        <span>Learn more</span>
      </div>
    </a>
  </div>
</section>
