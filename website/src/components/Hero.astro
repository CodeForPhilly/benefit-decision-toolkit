---
import { Content } from "../assets/text/Hero.md";
import ActionButton from "./ActionButton.astro";
---

<section id="hero" class="py-6 px-3 pb-12 bg-white">
  <div class="max-w-[85ch] mx-auto mt-20">
    <div
      class="prose prose-p:text-black prose-headings:text-heading prose-headings:text-left prose-headings:text-5xl! prose-p:text-xl! prose-p:leading-7! max-w-none"
    >
      <Content />
    </div>
    <div class="w-fit">
      <a href="/#projects">
        <ActionButton>Learn more</ActionButton>
      </a>
    </div>
  </div>
</section>
