---
import logo from "../assets/logos/bdt-logo-large-mono-dark.svg";
import { Image } from "astro:assets";
const footerLinks = [
  {
    title: "Home",
    path: "/",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/#contact",
  },
];
---

<footer class="py-12 bg-bdt-blue text-white">
  <div
    class="flex flex-col items-center gap-3 md:flex-row md:gap-24 w-fit mx-auto"
  >
    <div class="w-36">
      <a href="/">
        <Image src={logo} alt="BDT logo" />
      </a>
    </div>
    <div class="flex flex-col items-center gap-3">
      <nav class="flex flex-row gap-4">
        {
          footerLinks.map((link) => (
            <a class="font-bold w-fit" href={link.path}>
              {link.title}
            </a>
          ))
        }
      </nav>
      <p>
        <a
          class="underline font-medium text-white"
          href="https://codeforphilly.org/"
          target="_blank">A Code For Philly project</a
        >
      </p>
      <p class="text-sm! text-white!">
        Copyright © Benefit Decision Toolkit 2026
      </p>
    </div>
  </div>
</footer>
