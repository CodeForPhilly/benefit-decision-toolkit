---
import logo from "../assets/logos/bdt-logo-large-mono-dark.svg";
import { Image } from "astro:assets";
import cfpIcon from "../assets/icons/cfp-icon.svg";
import githubIcon from "../assets/icons/github-icon.svg";
const footerLinks = [
  {
    title: "Home",
    path: "/",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/#contact",
  },
];
---

<footer class="py-12 bg-linear-to-br from-bdt-blue to-bdt-gradient text-white">
  <div
    class="flex flex-col items-center gap-9 md:flex-row md:gap-24 w-fit mx-auto"
  >
    <div class="w-36">
      <a href="/">
        <Image src={logo} alt="BDT logo" />
      </a>
    </div>
    <div class="flex flex-col items-center gap-4 md:gap-6">
      <nav class="flex flex-row gap-4">
        {
          footerLinks.map((link) => (
            <a class="font-bold w-fit text-lg" href={link.path}>
              {link.title}
            </a>
          ))
        }
      </nav>
      <div class="flex gap-4">
        <a
          class="w-6"
          href="https://codeforphilly.org/projects/dmn_benefit_toolbox-including_the_philly_property_tax_relief_screener"
          target="_blank"
        >
          <Image src={cfpIcon} alt="Code For Philly logo" />
        </a>
        <a
          class="w-6"
          href="https://github.com/CodeForPhilly/benefit-decision-toolkit"
          target="_blank"
        >
          <Image src={githubIcon} alt="Code For Philly logo" />
        </a>
      </div>
      <p class="text-sm! text-white!">
        Copyright © Benefit Decision Toolkit 2026
      </p>
    </div>
  </div>
</footer>
