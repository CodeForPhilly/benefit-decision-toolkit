---
import { Image } from "astro:assets";
import { Content } from "../assets/text/Volunteer.md";
import cfpLogo from "../assets/logos/cfp-logo.svg";
import ActionButton from "./ActionButton.astro";
---

<section
  class="relative bg-white bg-[url(../assets/backgrounds/check-pattern.webp)] bg-size-[auto_900px] -my-12"
  id="volunteer"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-linear-to-b from-white to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-linear-to-t from-white to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative z-10 max-w-[85ch] mx-auto py-12 md:py-18 px-3 prose prose-a:font-medium"
  >
    <Content />
    <div
      class="flex flex-col items-center bg-bg border border-card-border w-fit mx-auto py-6 px-9 my-12 md:mb-6 rounded-lg"
    >
      <div class="max-w-36">
        <Image src={cfpLogo} alt="Code For Philly logo" width="300" />
      </div>
      <div class="w-fit">
        <a
          class="no-underline"
          href="https://codeforphilly.org/projects/dmn_benefit_toolbox-including_the_philly_property_tax_relief_screener"
          target="_blank"
        >
          <ActionButton>Connect</ActionButton>
        </a>
      </div>
    </div>
  </div>
</section>
