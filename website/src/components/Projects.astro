---
import { render } from "astro:content";
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
import { Content } from "../assets/text/Projects.md";
---

<section id="projects">
  <div class="max-w-[130ch] mx-auto py-12 px-3">
    <div class="max-w-[85ch] mx-auto pb-9 prose">
      <Content />
    </div>
    <ul class="flex flex-col sm:flex-row gap-6 justify-center">
      {
        projects.map(async (project) => {
          const { Content } = await render(project);
          return (
            <li class="bg-bg sm:p-6 px-3 py-4 rounded-2xl md:w-1/2">
              <div class="prose prose-a:font-medium prose-img:rounded-2xl prose-img:border prose-img:border-gray-400">
                <Content />
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
